{
    "type": "module",
    "scripts": {
      "start": "node dist/main.js",
      "dev": "npx tsx watch main.ts",
      "build": "tsc --build",
      "clean": "rm -rf dist",
      "db:init": "npx tsx database/index.ts create",
      "db:populate": "npx tsx database/index.ts seed",
      "db:clear": "npx tsx database/index.ts reset",
      "db:rebuild": "npx tsx database/index.ts create --force && npx tsx database/index.ts seed",
      "lint": "oxlint .",
      "format": "oxfmt ."
    },
    "devDependencies": {
      "@faker-js/faker": "^10.2.0",
      "@tsconfig/recommended": "^1.0.13",
      "@types/better-sqlite3": "^7.6.13",
      "@types/express": "^5.0.6",
      "@types/node": "^25.2.3",
      "@vitest/coverage-v8": "^4.0.18",
      "oxfmt": "^0.32.0",
      "oxlint": "^1.23.0",
      "tsx": "^4.21.0",
      "typescript": "^5.9.3",
      "vitest": "^4.0.17"
    },
    "dependencies": {
      "better-sqlite3": "^12.9.0",
      "chalk": "^5.6.2",
      "express": "^5.2.1",
      "express-handlebars": "^8.0.1",
      "kysely": "^0.28.16",
      "ora": "^9.3.0",
      "valibot": "^1.2.0"
    }
  }