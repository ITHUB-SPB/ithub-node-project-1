<main class="page">
    {{> brand}}

    <div class="room-layout">
        <section>
            <div class="hero-photo" aria-label="Комната {{room.title}}"></div>
            <h2 class="slots-title">Занятые слоты</h2>
            <div class="slots">
                {{#each slots}}
                <article class="slot-card">
                    <h3>{{this.title}}</h3>
                    <p><strong>Организатор :</strong> {{this.organizer}}</p>
                    <p>{{this.period}}</p>
                </article>
                {{/each}}
            </div>
        </section>

        <section class="room-info" aria-label="Информация о комнате">
            <h1>Комната {{room.title}}</h1>
            <div class="feature-grid">
                <div class="feature">
                    <div class="feature__icon">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M12 18.5a1.9 1.9 0 1 0 0-3.8 1.9 1.9 0 0 0 0 3.8Zm-4.2-4.1 1.7 1.7a3.6 3.6 0 0 1 5 0l1.7-1.7a6 6 0 0 0-8.4 0Zm-3.4-3.3 1.7 1.7a8.4 8.4 0 0 1 11.8 0l1.7-1.7a10.8 10.8 0 0 0-15.2 0Zm-3.3-3.3 1.7 1.7a13.1 13.1 0 0 1 18.4 0l1.7-1.7a15.5 15.5 0 0 0-21.8 0Z"
                            />
                        </svg>
                    </div>
                    <span>{{room.wifiLabel}}</span>
                </div>
                <div class="feature">
                    <div class="feature__icon">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M8 4a3 3 0 0 1 3-3h2a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3h-2a3 3 0 0 1-3-3V4Zm-4 7h2a5 5 0 0 0 4 4.9V18H7v2h10v-2h-3v-2.1a5 5 0 0 0 4-4.9h2a7 7 0 0 1-6 6.9V18h-4v-.1A7 7 0 0 1 4 11Z"
                            />
                        </svg>
                    </div>
                    <span>{{room.capacity}}</span>
                </div>
                <div class="feature">
                    <div class="feature__icon">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M4 4h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-7v2h4v2H7v-2h4v-2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm0 2v10h16V6H4Z"
                            />
                        </svg>
                    </div>
                    <span>{{room.plasmaLabel}}</span>
                </div>
                <div class="feature">
                    <div class="feature__icon">
                        <svg viewBox="0 0 24 24">
                            <path
                                d="M16 3h6v18h-6v-2h4V5h-4V3ZM3 7a2 2 0 1 1 4 0 2 2 0 0 1-4 0Zm1 4h5a3 3 0 0 1 3 3v6h-2v-6a1 1 0 0 0-1-1H8v7H6v-5H4v5H2v-7a2 2 0 0 1 2-2Zm10-2h4v2h-4V9Zm-1 4h5v2h-5v-2Z"
                            />
                        </svg>
                    </div>
                    <span>{{room.boardLabel}}</span>
                </div>
            </div>

            <div class="actions">
                <a class="button button--brown" href="/">Back to Rooms</a>
                <a class="button button--teal" href="/booking/{{room.id}}">Booking Details</a>
            </div>
        </section>
    </div>
</main>
