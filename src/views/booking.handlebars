<div class="page page--booking">
    <div class="aside">
        {{> brand}}
    </div>

    <section class="booking">
        <h2>Создание бронирования</h2>

        {{#if success}}
            <div class="alert alert--success">{{success}}</div>
        {{/if}}
        
        {{#if error}}
            <div class="alert alert--error">{{error}}</div>
        {{/if}}

        <form method="post" action="/booking/{{room.id}}">
            <label for="title">Название мероприятия</label>
            <input type="text" name="title" required minlength="2" placeholder="Стендапчик">

            <label for="username">Организатор</label>
            <input type="text" name="username" required minlength="2" placeholder="Ваше имя">

            <label>Слот</label>
            <select name="timeslotId" required>
                {{#each timeslots}}
                    <option value="{{this.id}}">{{this.start}} - {{this.end}}</option>
                {{/each}}
            </select>

            <button type="submit">Забронировать</button>
        </form>
    </section>
</div>
