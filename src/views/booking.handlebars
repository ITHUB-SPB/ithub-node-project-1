<main class="page page--booking">
  <div class="booking-layout">
    <section class="booking-left">
      {{> brand}}

      <img class="detail-image" src="{{room.detailImage}}" alt="Комната {{room.title}}" />

      <section class="busy">
        <h2>Занятые слоты</h2>

        <div class="busy__list">
          {{#each room.bookings}}
            <article class="busy-card">
              <h3>{{this.title}}</h3>
              <p><strong>Организатор :</strong> {{this.organizer}}</p>
              <p>{{this.time}}</p>
            </article>
          {{/each}}
        </div>
      </section>
    </section>

    <form class="booking-form" action="/booking/{{room.id}}" method="post" id="bookingForm">
      <h1 class="booking-form__title">Бронирование {{room.title}}</h1>

      <div id="clientErrors" class="form-errors form-errors--hidden"></div>

      {{#if errors}}
        <div class="form-errors">
          {{#each errors}}
            <p>{{this}}</p>
          {{/each}}
        </div>
      {{/if}}

      <label>
        <span>Тема</span>
        <input
          type="text"
          name="title"
          minlength="2"
          required
          value="{{form.title}}"
        />
      </label>

      <label>
        <span>Организатор</span>
        <input
          type="text"
          name="organizer"
          minlength="2"
          required
          value="{{form.organizer}}"
        />
      </label>

      <div class="booking-form__time">
        <label>
          <span>Начало</span>
          <input type="time" name="start" required value="{{form.start}}" />
        </label>

        <label>
          <span>Конец</span>
          <input type="time" name="end" required value="{{form.end}}" />
        </label>
      </div>

      <section class="available-slots">
        <h2>Свободные слоты</h2>
        <p class="available-slots__hint">Нажми на слот, чтобы подставить время в форму.</p>

        <div
          class="available-slots__list"
          id="availableSlots"
          data-room-id="{{room.id}}"
        >
          Загрузка слотов...
        </div>
      </section>

      <div class="booking-form__actions">
        <a class="button button--muted" href="/rooms/{{room.id}}">Back to Room</a>
        <button class="button" type="submit">Book</button>
      </div>
    </form>
  </div>
</main>

<script src="/public/booking.js"></script>