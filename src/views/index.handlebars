<main class="page">
  <aside class="sidebar" aria-label="Фильтры комнат">
    <form class="filters" method="GET" action="/">
      <section class="filter-group">
        <h2>Комнаты</h2>
        {{#each allRoomsForFilter}}
        <label>
          <input type="checkbox" name="filter" value="{{this.id}}" {{#if (includes this.id ../filters.filter)}}checked{{/if}} />
          <span>{{this.title}}</span>
        </label>
        {{/each}}
      </section>

      <section class="filter-group">
        <h2>Доступность</h2>
        <label>
          <input type="checkbox" name="amenities" value="plasma" {{#if (includes "plasma" filters.amenities)}}checked{{/if}} />
          <span>Плазма</span>
        </label>
        <label>
          <input type="checkbox" name="amenities" value="board" {{#if (includes "board" filters.amenities)}}checked{{/if}} />
          <span>Доска</span>
        </label>
        <label>
          <input type="checkbox" name="amenities" value="wifi" {{#if (includes "wifi" filters.amenities)}}checked{{/if}} />
          <span>Wi-Fi</span>
        </label>
      </section>

      <section class="filter-group">
        <h2>Вместимость</h2>
        <input class="pill-input pill-input--single" type="number" name="capacity" value="{{filters.capacity}}" aria-label="Вместимость" placeholder="от" />
      </section>

      <div class="filter-actions">
        <button class="clear-button" type="reset">Очистить</button>
        <button class="apply-button" type="submit">Применить</button>
      </div>
    </form>
  </aside>

  <section aria-label="Список комнат">
    <p class="result-count">Найдено комнат: <strong>{{rooms.length}}</strong></p>
    <div class="room-grid">
      {{#each rooms}}
      <article class="room-card">
        <div class="room-card__image" aria-label="Переговорная комната"></div>
        <h3>{{this.title}}</h3>
        <p class="room-card__place">
          <svg width="15" height="20" viewBox="0 0 15 20" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7.39485 9.5C6.69441 9.5 6.02266 9.23661 5.52737 8.76777C5.03208 8.29893 4.75383 7.66304 4.75383 7C4.75383 6.33696 5.03208 5.70107 5.52737 5.23223C6.02266 4.76339 6.69441 4.5 7.39485 4.5C8.09529 4.5 8.76705 4.76339 9.26234 5.23223C9.75762 5.70107 10.0359 6.33696 10.0359 7C10.0359 7.3283 9.96756 7.65339 9.83484 7.95671C9.70211 8.26002 9.50758 8.53562 9.26234 8.76777C9.01709 8.99991 8.72595 9.18406 8.40553 9.3097C8.0851 9.43534 7.74168 9.5 7.39485 9.5ZM7.39485 0C5.43362 0 3.55271 0.737498 2.1659 2.05025C0.779098 3.36301 0 5.14348 0 7C0 12.25 7.39485 20 7.39485 20C7.39485 20 14.7897 12.25 14.7897 7C14.7897 5.14348 14.0106 3.36301 12.6238 2.05025C11.237 0.737498 9.35609 0 7.39485 0Z" fill="#9E5CFF"/>
          </svg>
          <span>Dev Bay, Chennai</span>
        </p>
        <p class="room-card__limit"><strong>Max Limit :</strong> {{this.capacity}}</p>
        <div class="room-card__amenities">
          {{#each this.amenities}}
          <span class="amenity-badge">{{this.label}}</span>
          {{/each}}
        </div>
        <a class="more-button" href="/details/{{this.id}}">More Info</a>
      </article>
      {{else}}
      <p>Комнат не найдено</p>
      {{/each}}
    </div>
  </section>
</main>