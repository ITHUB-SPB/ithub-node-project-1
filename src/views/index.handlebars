<div class="page page--index">
    <div class="aside">
        {{> brand}}
        {{> filters
            roomsFilter=roomsFilter
            query=query
        }}
    </div>

    <section class="rooms">
        {{#each rooms}}
        <article class="room_card">
            <header>
                <a href="/details/{{this.id}}">{{this.title}}</a>
            </header>
            <footer>
                <p>Вместимость: {{this.capacity}}</p>

                <p>
                    {{#if this.wifi}}Wi-Fi{{/if}}
                    {{#if this.board}}Доска{{/if}}
                    {{#if this.plasma}}Плазма{{/if}}
                </p>
            </footer>
        </article>
        {{/each}}
    </section>
</div>
