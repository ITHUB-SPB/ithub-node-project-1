<aside class="filters">
    <form action="/" method="get">
        <h4>Комнаты</h4>

        {{#each roomsFilter}}
            <section class="field">
                <input
                    type="checkbox"
                    name="filter"
                    id="room-{{this.id}}"
                    value="{{this.id}}"
                />
                <label for="room-{{this.id}}">{{this.title}}</label>
            </section>
        {{/each}}

        <h4>Вместимость</h4>

        <input
            type="number"
            name="capacity"
            min="1"
            placeholder="Минимум мест"
            value="{{query.capacity}}"
        />

        <section class="buttons">
            <button type="reset">Очистить</button>
            <button type="submit">Применить</button>
        </section>
    </form>
</aside>