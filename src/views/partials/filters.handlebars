<form class="filters" method="get" action="/">
    <section class="filter-group">
        <h2>Комнаты</h2>
        {{#each roomsFilter}}
        <label for="room-{{this.id}}">
            <input type="checkbox" name="filter" id="room-{{this.id}}" value="{{this.id}}" {{#if this.checked}}checked{{/if}}>
            <span>{{this.title}}</span>
        </label>
        {{/each}}
    </section>

    <section class="filter-group">
        <h2>Доступность</h2>
        <label for="plasma">
            <input type="checkbox" name="plasma" id="plasma" value="1" {{#if filters.plasma}}checked{{/if}}>
            <span>Плазма</span>
        </label>
        <label for="board">
            <input type="checkbox" name="board" id="board" value="1" {{#if filters.board}}checked{{/if}}>
            <span>Доска</span>
        </label>
        <label for="wifi">
            <input type="checkbox" name="wifi" id="wifi" value="1" {{#if filters.wifi}}checked{{/if}}>
            <span>Wi-Fi</span>
        </label>
    </section>

    <section class="filter-group">
        <h2>Вместимость</h2>
        <input
            class="pill-input pill-input--single"
            type="text"
            name="capacity"
            pattern="\d{1,3}"
            value="{{filters.capacity}}"
            aria-label="Вместимость"
        >
    </section>

    <section class="filter-group">
        <h2>Время</h2>
        <div class="time-row">
            <input class="pill-input" type="text" aria-label="Начало">
            <input class="pill-input" type="text" aria-label="Конец">
        </div>
    </section>

    <div class="filter-actions">
        <button class="clear-button" type="reset">Очистить</button>
        <button class="apply-button" type="submit">Применить</button>
    </div>
</form>
